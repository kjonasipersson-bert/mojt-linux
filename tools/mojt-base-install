"""Install and switch Mojt Base generations in a directory (prototype v0.1).

Host dependencies: Python >= 3.11, GNU tar, zstd; run as root for install.

This manages VERSIONED ROOTFS DIRECTORIES and persistent state; it does NOT
boot the machine or make bind mounts. Mount the persistent state directories
inside the selected rootfs in a private mount namespace before testing it with chroot.

Only install local releases built by a trusted mojt-base-pack. SHA256 detects
corruption but does not authenticate releases; signature verification is TODO.
"""

import argparse
import fcntl
import hashlib
import os
from pathlib import Path, PurePosixPath
import platform
import posixpath
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import tomllib

LABEL = re.compile(r"[A-Za-z0-9][A-Za-z0-9._+-]*\Z")
SHA256 = re.compile(r"[0-9a-f]{64}\Z")
OS_RELEASE_LINK = "../usr/lib/os-release"


class InstallError(Exception):
    pass


def fail(message):
    raise InstallError(message)


def valid_label(value, field):
    if not isinstance(value, str) or not LABEL.fullmatch(value) or value in (".", ".."):
        fail(f"invalid {field}: {value!r}")
    return value


def validate_manifest(release):
    manifest_file = release / "manifest.toml"
    if not manifest_file.is_file() or manifest_file.is_symlink():
        fail(f"missing regular manifest: {manifest_file}")
    with manifest_file.open("rb") as handle:
        m = tomllib.load(handle)
    if m.get("format") != 1:
        fail("unsupported manifest schema (expected format = 1)")
    base, image, state = (m.get(k) for k in ("base", "image", "state"))
    if not all(isinstance(k, dict) for k in (base, image, state)):
        fail("manifest lacks [base], [image], or [state]")
    if base.get("name") != "mojt":
        fail("not a Mojt Base release")
    version = valid_label(base.get("version"), "base.version")
    arch = valid_label(base.get("architecture"), "base.architecture")
    if arch != platform.machine():
        fail(f"architecture mismatch: release={arch}, host={platform.machine()}")
    if image.get("file") != "rootfs.tar.zst":
        fail("unsupported image.file (expected rootfs.tar.zst)")
    digest = image.get("sha256")
    if not isinstance(digest, str) or not SHA256.fullmatch(digest):
        fail("missing or invalid image.sha256")
    if state.get("layout_version") != 1:
        fail("unsupported state.layout_version (expected 1)")
    if state.get("etc_defaults") != "/usr/etc":
        fail("unsupported state.etc_defaults")
    if state.get("etc_policy") != "add-missing":
        fail("unsupported state.etc_policy")
    if state.get("var_policy") != "persistent":
        fail("unsupported state.var_policy")
    return version, digest, state["layout_version"]


def sha256_file(path):
    h = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1024 * 1024), b""):
            h.update(block)
    return h.hexdigest()


def audit_tar(path):
    """Check tar paths before extraction into a new, private staging directory.

    A Linux rootfs legitimately contains absolute symbolic links, e.g.
    /etc/ssl/certs/foo.pem -> /usr/share/ca-certificates/foo.crt.
    Their targets refer to the *installed* rootfs, not the installer host.
    Keep such links unchanged, but reject archive entries that would write
    through a symlink, as well as escaping paths and unsafe hard links.

    This is defense in depth, not release authentication: signed manifests
    must be added before installing untrusted/network-supplied releases.
    """
    entries = {}
    with tarfile.open(path, "r:") as archive:
        for member in archive:
            name = member.name
            rel = PurePosixPath(name)
            if rel.is_absolute() or ".." in rel.parts:
                fail(f"unsafe archive entry: {name!r}")
            norm = posixpath.normpath(name)
            if norm == ".":
                if not member.isdir():
                    fail("archive root must be a directory")
                continue
            if norm in entries:
                fail(f"duplicate archive entry: {name!r}")
            if not (member.isdir() or member.isfile() or member.issym() or member.islnk()):
                fail(f"unsupported archive object: {name!r}")

            if member.issym():
                if not member.linkname:
                    fail(f"empty symbolic link: {name!r}")
                if not member.linkname.startswith("/"):
                    # A relative link must stay within the virtual rootfs.
                    dest = posixpath.normpath(posixpath.join(
                        posixpath.dirname(norm), member.linkname))
                    if dest == ".." or dest.startswith("../"):
                        fail(f"escaping symbolic link: {name!r} -> {member.linkname!r}")
                # Absolute symlinks are valid rootfs data. We never follow
                # their targets while unpacking or populating persistent state.
            elif member.islnk():
                link = member.linkname
                if not link or link.startswith("/") or ".." in PurePosixPath(link).parts:
                    fail(f"unsafe hard link: {name!r} -> {link!r}")
            entries[norm] = member

    # GNU tar must never be asked to unpack a file *under* a symlink,
    # whether that symlink appeared earlier or later in archive order.
    # Also reject entries under non-directories and hard links to anything
    # but an ordinary file in the same image.
    for name, member in entries.items():
        parent = posixpath.dirname(name)
        while parent not in ("", "."):
            ancestor = entries.get(parent)
            if ancestor is not None and not ancestor.isdir():
                fail(f"archive entry traverses non-directory: {name!r} under {parent!r}")
            parent = posixpath.dirname(parent)
        if member.islnk():
            dest = posixpath.normpath(member.linkname)
            target = entries.get(dest)
            if target is None or not target.isfile():
                fail(f"hard link target is not a regular archive file: {name!r} -> {member.linkname!r}")


def run(*cmd):
    subprocess.run(cmd, check=True)


def copy_ownership(src, dest, *, follow_symlinks=True):
    stat = src.stat(follow_symlinks=follow_symlinks)
    os.chown(dest, stat.st_uid, stat.st_gid, follow_symlinks=follow_symlinks)


STAGING_MARKER = "mojt-base-install-stage-v1\n"


def sync_file(path):
    """Request durable content/metadata for a regular file (Linux host)."""
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def sync_directory(path):
    """Persist directory entries; required after rename/unlink/symlink."""
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def sync_tree(root):
    """Flush a staged rootfs before exposing it as a Base generation."""
    for parent, dirs, files in os.walk(root, topdown=False, followlinks=False):
        for name in files:
            path = Path(parent) / name
            if not path.is_symlink():
                if not path.is_file():
                    fail(f"unsupported rootfs object for sync: {path}")
                sync_file(path)
        for name in dirs:
            path = Path(parent) / name
            if not path.is_symlink() and not path.is_dir():
                fail(f"unsupported rootfs directory for sync: {path}")
        sync_directory(parent)


def sync_created(created):
    """Flush newly populated state files and their directory entries."""
    dirs = set()
    for path, is_dir in created:
        if is_dir:
            dirs.add(path)
        elif not path.is_symlink():
            sync_file(path)
        dirs.add(path.parent)
    for directory in sorted(dirs, key=lambda p: len(p.parts), reverse=True):
        sync_directory(directory)


def ensure_directory(path, created, mode=0o777):
    """Create only a missing directory; reject links and conflicting files."""
    if path.is_symlink() or (path.exists() and not path.is_dir()):
        fail(f"expected a state directory, not a file or link: {path}")
    if not path.exists():
        path.mkdir(mode=mode)
        created.append((path, True))


def rollback_created(created):
    """Undo only entries created by this invocation, in reverse order.

    Does not attempt crash recovery or remove a directory modified by another
    process. A failed cleanup is reported rather than deleting existing data.
    """
    for path, is_dir in reversed(created):
        try:
            if is_dir:
                path.rmdir()
            else:
                path.unlink(missing_ok=True)
        except OSError as error:
            print(f"mojt-base-install: rollback incomplete for {path}: {error}",
                  file=sys.stderr)


def add_defaults(source, dest, created):
    """Add missing defaults and journal each creation for error rollback."""
    if not source.is_dir() or source.is_symlink():
        fail(f"missing /usr/etc defaults: {source}")
    for entry in sorted(source.iterdir(), key=lambda p: p.name):
        if entry.name == "os-release":
            continue  # /etc/os-release is a special relative symlink.
        target = dest / entry.name
        if entry.is_symlink():
            if not os.path.lexists(target):
                os.symlink(os.readlink(entry), target)
                created.append((target, False))
                copy_ownership(entry, target, follow_symlinks=False)
        elif entry.is_dir():
            if target.is_symlink():
                continue  # Never follow an existing user-controlled symlink.
            if not target.exists():
                target.mkdir(mode=entry.stat().st_mode & 0o7777)
                created.append((target, True))
                os.chmod(target, entry.stat().st_mode & 0o7777)
                copy_ownership(entry, target)
            if not target.is_dir():
                continue  # Preserve a conflicting local file.
            add_defaults(entry, target, created)
        elif entry.is_file():
            if not os.path.lexists(target):
                # O_EXCL prevents replacing an existing local file.
                with entry.open("rb") as reader:
                    fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
                    created.append((target, False))
                    with os.fdopen(fd, "wb") as writer:
                        shutil.copyfileobj(reader, writer)
                shutil.copystat(entry, target)
                copy_ownership(entry, target)
        else:
            fail(f"unsupported default file type: {entry}")


def prepare_state(target, defaults, layout, created):
    state = target / "state"
    etc = state / "etc"
    var = state / "var"
    layout_file = state / "layout-version"
    os_release = etc / "os-release"

    # Reject known conflicts before writing any state defaults.
    if not defaults.is_dir() or defaults.is_symlink():
        fail(f"missing /usr/etc defaults: {defaults}")
    if state.is_symlink() or (state.exists() and not state.is_dir()):
        fail("persistent state must be a directory, not a symlink or file")
    if layout_file.is_symlink():
        fail("persistent state layout marker must not be a symlink")
    if layout_file.exists():
        if layout_file.read_text(encoding="ascii").strip() != str(layout):
            fail("persistent state layout incompatible with this release")
    for directory in (etc, var, state / "home", state / "root"):
        if directory.is_symlink() or (directory.exists() and not directory.is_dir()):
            fail(f"persistent state mount point must be a directory: {directory}")
    if os.path.lexists(os_release) and (
        not os_release.is_symlink() or os.readlink(os_release) != OS_RELEASE_LINK
    ):
        fail("existing /etc/os-release is not Mojt's expected relative symlink; refusing overwrite")

    ensure_directory(state, created)
    ensure_directory(etc, created)
    ensure_directory(var, created)
    ensure_directory(state / "home", created, mode=0o755)
    ensure_directory(state / "root", created, mode=0o700)
    add_defaults(defaults, etc, created)

    if not os.path.lexists(os_release):
        os.symlink(OS_RELEASE_LINK, os_release)
        created.append((os_release, False))
    if not layout_file.exists():
        fd = os.open(layout_file, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
        created.append((layout_file, False))
        with os.fdopen(fd, "w", encoding="ascii") as writer:
            writer.write(f"{layout}\n")


def check_rootfs(stage, version):
    osrel = stage / "usr/lib/os-release"
    if not osrel.is_file():
        fail("image missing /usr/lib/os-release")
    contents = osrel.read_text(encoding="utf-8")
    if "ID=mojt\n" not in contents or f'IMAGE_VERSION="{version}"' not in contents:
        fail("image os-release identity/version disagrees with manifest")
    for name in ("etc", "var"):
        d = stage / name
        if not d.is_dir() or d.is_symlink() or any(d.iterdir()):
            fail(f"image /{name} is not an empty directory")
    if not (stage / "usr/etc").is_dir():
        fail("image missing /usr/etc")


def current_version(target):
    link = target / "base/current"
    if not link.is_symlink():
        if os.path.lexists(link):
            fail("base/current exists but is not a symlink")
        return None
    value = os.readlink(link)
    valid_label(value, "base/current")
    if not (target / "base" / value).is_dir():
        fail("base/current points to a missing generation")
    return value


def activate(target, version):
    version = valid_label(version, "version")
    generation = target / "base" / version
    if generation.is_symlink() or not generation.is_dir():
        fail(f"Base generation not installed: {version}")
    # An interrupted installation may have published a rootfs but not its
    # manifest. Never activate a generation without committed metadata.
    metadata = target / "releases" / f"base-{version}.toml"
    if metadata.is_symlink() or not metadata.is_file():
        fail(f"Base generation has no committed release metadata: {version}")
    current_version(target)  # Refuse to replace a directory or invalid symlink.
    link = target / "base/current"
    temp_link = target / "base" / f".current-{os.getpid()}"
    os.symlink(version, temp_link)
    try:
        os.replace(temp_link, link)  # Atomic on the same filesystem.
        sync_directory(link.parent)  # Persist the new symlink directory entry.
    finally:
        temp_link.unlink(missing_ok=True)


def install(args, target):
    release = args.release.resolve(strict=True)
    if not release.is_dir():
        fail("release must be a directory")
    version, expected_hash, layout = validate_manifest(release)
    image = release / "rootfs.tar.zst"
    if not image.is_file() or image.is_symlink():
        fail("missing regular rootfs.tar.zst")
    actual_hash = sha256_file(image)
    if actual_hash != expected_hash:
        fail(f"SHA256 mismatch (expected {expected_hash}; got {actual_hash})")

    base = target / "base"
    base.mkdir(parents=True, exist_ok=True)
    destination = base / version
    if os.path.lexists(destination):
        fail(f"generation already installed: {destination}")
    metadata_file = target / "releases" / f"base-{version}.toml"
    if os.path.lexists(metadata_file):
        fail(f"release metadata already exists: {metadata_file}")
    if not args.no_activate:
        current_version(target)  # Reject a corrupt current link before touching state.

    if not shutil.which("zstd") or not shutil.which("tar"):
        fail("requires zstd and GNU tar on the installing host")

    with tempfile.TemporaryDirectory(prefix=".install-", dir=base) as tmp:
        # Identifies interrupted *staging* directories for explicit recovery.
        # The marker is outside the rootfs image and is never installed.
        marker = Path(tmp) / ".mojt-install-stage"
        marker.write_text(STAGING_MARKER, encoding="ascii")
        sync_file(marker)
        sync_directory(tmp)
        sync_directory(base)

        stage = Path(tmp) / "rootfs"
        stage.mkdir()
        tar_path = Path(tmp) / "image.tar"
        with tar_path.open("wb") as output:
            subprocess.run(["zstd", "-dc", str(image)], stdout=output, check=True)
        audit_tar(tar_path)
        run("tar", "--numeric-owner", "--acls", "--xattrs", "--xattrs-include=*",
            "-xf", str(tar_path), "-C", str(stage))
        check_rootfs(stage, version)

        # The rootfs becomes visible only once its contents are flushed.
        # The active generation is switched only after state and metadata are
        # published. Power loss still cannot atomically roll back /etc defaults.
        sync_tree(stage)
        created = []
        generation_installed = False
        try:
            prepare_state(target, stage / "usr/etc", layout, created)
            sync_created(created)
            stage.rename(destination)
            generation_installed = True
            sync_directory(base)

            ensure_directory(metadata_file.parent, created)
            # Write release metadata to a temporary sibling, then publish
            # it by rename. A crash cannot expose a half-written manifest.
            fd, temp_name = tempfile.mkstemp(prefix=".base-install-", dir=metadata_file.parent)
            temp_metadata = Path(temp_name)
            try:
                with (release / "manifest.toml").open("rb") as reader:
                    with os.fdopen(fd, "wb") as writer:
                        shutil.copyfileobj(reader, writer)
                shutil.copystat(release / "manifest.toml", temp_metadata)
                sync_file(temp_metadata)
                os.replace(temp_metadata, metadata_file)
                created.append((metadata_file, False))
                sync_directory(metadata_file.parent)
            finally:
                temp_metadata.unlink(missing_ok=True)
            sync_created(created)

            if not args.no_activate:
                activate(target, version)  # Last operation: durable symlink swap.
        except BaseException:
            # A failed directory fsync *after* os.replace means the active
            # symlink may already point at this generation. Never delete it.
            current = target / "base/current"
            if current.is_symlink() and os.readlink(current) == version:
                print("mojt-base-install: activation may have completed; "
                      "leaving generation and state intact for inspection",
                      file=sys.stderr)
                raise
            if generation_installed:
                try:
                    shutil.rmtree(destination)
                    sync_directory(base)
                except OSError as error:
                    print(f"mojt-base-install: rollback incomplete for {destination}: {error}",
                          file=sys.stderr)
            rollback_created(created)
            raise

    print(f"Installed Base {version}: {destination}")
    print(f"Persistent state:  {target / 'state'}")
    print(f"Current version:   {current_version(target) or '(none)'}")
    print("Note: this is a directory installation, not a bootable system.")



def recover(target):
    """Discard only recognizable stale extraction stages, under the install lock.

    Orphaned published Base generations are reported, never deleted: they
    could hold data and require operator inspection before any removal.
    """
    base = target / "base"
    cleaned = 0
    orphans = 0
    if base.is_dir() and not base.is_symlink():
        for entry in sorted(base.iterdir()):
            if not entry.name.startswith(".install-") or entry.is_symlink() or not entry.is_dir():
                continue
            marker = entry / ".mojt-install-stage"
            if marker.is_symlink() or not marker.is_file():
                continue
            if marker.read_text(encoding="ascii") != STAGING_MARKER:
                continue
            shutil.rmtree(entry)
            sync_directory(base)
            cleaned += 1
        current = current_version(target)
        for entry in sorted(base.iterdir()):
            if entry.name.startswith(".") or entry.name == "current":
                continue
            if entry.is_symlink() or not entry.is_dir():
                continue
            if not LABEL.fullmatch(entry.name) or entry.name in (".", ".."):
                continue
            metadata = target / "releases" / f"base-{entry.name}.toml"
            if not metadata.is_file() or metadata.is_symlink():
                orphans += 1
                print(f"Incomplete generation retained: {entry} "
                      "(missing release metadata; inspect manually)")
            elif entry.name == current:
                pass
    print(f"Recovered staging directories: {cleaned}")
    print(f"Published generations needing inspection: {orphans}")



def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    install_parser = sub.add_parser("install", help="verify and install a Base release")
    install_parser.add_argument("release", type=Path)
    install_parser.add_argument("--no-activate", action="store_true")
    activate_parser = sub.add_parser("activate", help="select an installed Base generation")
    activate_parser.add_argument("version")
    sub.add_parser("status", help="show installed Base generations")
    sub.add_parser("recover", help="remove orphaned installer staging directories")
    for p in (install_parser, activate_parser, sub.choices["status"], sub.choices["recover"]):
        p.add_argument("--target", type=Path, required=True,
                       help="installation directory, e.g. ~/mojt-lab/installation")
    args = parser.parse_args()
    if args.command != "status" and os.geteuid() != 0:
        fail("install and activate require root (sudo)")
    target = args.target.absolute()
    if target.is_symlink():
        fail("installation target must not be a symlink")
    if args.command == "status" and not target.exists():
        fail(f"installation target not found: {target}")
    if args.command != "status":
        target.mkdir(parents=True, exist_ok=True)
    lock_path = target / ".install-lock"
    if args.command == "status":
        lock = lock_path.open("rb")  # Status works without root privileges.
    else:
        lock = lock_path.open("a+b")
    with lock:
        fcntl.flock(lock, fcntl.LOCK_SH if args.command == "status" else fcntl.LOCK_EX)
        if args.command == "install":
            install(args, target)
        elif args.command == "activate":
            activate(target, args.version)
            print(f"Current Base: {current_version(target)}")
        elif args.command == "recover":
            recover(target)
        elif args.command == "status":
            current = current_version(target)
            print(f"Target:  {target}")
            print(f"Current: {current or '(none)'}")
            base = target / "base"
            for p in sorted(base.iterdir()) if base.is_dir() else []:
                if p.is_dir() and p.name != "current" and not p.name.startswith("."):
                    print(f"  {'*' if p.name == current else ' '} {p.name}")
            print(f"State:   {target / 'state'}")


if __name__ == "__main__":
    try:
        main()
    except (InstallError, OSError, subprocess.CalledProcessError, tomllib.TOMLDecodeError) as e:
        print(f"mojt-base-install: {e}", file=sys.stderr)
        raise SystemExit(1)
