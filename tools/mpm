"""Repository entry point: local discovery before optional provider dispatch."""

from pathlib import Path
import runpy
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))

if len(sys.argv) >= 2 and sys.argv[1] == "catalog":
    from mpm_catalog import main
    raise SystemExit(main(sys.argv[2:]))
elif (len(sys.argv) >= 3 and sys.argv[1] in ("base", "system", "kernel", "ports")
      and ((sys.argv[2] in ("search", "show", "versions")
            and any(a == "--catalog" or a.startswith("--catalog=") for a in sys.argv[3:]))
           or sys.argv[1:3] == ["kernel", "resolve"])):
    from mpm_catalog import main
    action = "resolve-kernel" if sys.argv[2] == "resolve" else sys.argv[2]
    # Area belongs to the command; users cannot override it with another --area.
    if any(arg == "--area" or arg.startswith("--area=") for arg in sys.argv[3:]):
        raise SystemExit("mpm: area already specified by command")
    raise SystemExit(main([action, *sys.argv[3:], "--area", sys.argv[1]]))
else:
    runpy.run_path(str(Path(__file__).with_name("mpm-nix-prototype")), run_name="__main__")
